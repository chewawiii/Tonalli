{
	"format_version": "1.26.50",
	"minecraft:block": {
		"description": {
			"identifier": "tonalli:mictlan_spawner",
			"menu_category": {
				"category": "nature"
			},
			"states": {
				"to:state": ["none", "idle", "active", "ejected", "cooldown"],
				"to:is_ominouse": [false, true]
			}
		},
		"components": {
			"minecraft:block_entity": {
				"dynamic_properties": true
			},
			"tonalli:mictlan_spawner": {
				"lootTable": "chests/mictlan_spawner/mictlan_spawner",
				"ominousLootTable": "chests/mictlan_spawner/mictlan_spawner_ominous",
				"cooldown": 30 // minutos
			},
			"minecraft:geometry": "minecraft:geometry.full_block",
			"minecraft:material_instances": {
				"*": { "texture": "mictlan_spawner_side_off", "render_method": "alpha_test" },
				"up": { "texture": "mictlan_spawner_top_off", "render_method": "alpha_test" },
				"down": { "texture": "mictlan_spawner_bottom", "render_method": "alpha_test" }
			},
			"minecraft:sound": {
				"sound": "trial_spawner"
			},
			"minecraft:destructible_by_mining": false,
			"minecraft:destructible_by_explosion": false,
			"minecraft:movable": {
				"movement_type": "immovable"
			},
			"minecraft:tick": {
				"interval_range": [20, 20],
				"looping": true
			}
		},
		"permutations": [
			{
				"condition": "query.block_state('to:state') == 'cooldown'",
				"components": {
					"minecraft:material_instances": {
						"*": { "texture": "mictlan_spawner_side_off", "render_method": "alpha_test" },
						"up": { "texture": "mictlan_spawner_top_off", "render_method": "alpha_test" },
						"down": { "texture": "mictlan_spawner_bottom", "render_method": "alpha_test" }
					}
				}
			},
			{
				"condition": "query.block_state('to:is_ominouse') && (query.block_state('to:state') == 'idle' || query.block_state('to:state') == 'active')",
				"components": {
					"minecraft:material_instances": {
						"*": { "texture": "mictlan_spawner_side_ominouse", "render_method": "alpha_test" },
						"up": { "texture": "mictlan_spawner_top_ominouse", "render_method": "alpha_test" },
						"down": { "texture": "mictlan_spawner_bottom", "render_method": "alpha_test" }
					}
				}
			},
			{
				"condition": "query.block_state('to:is_ominouse') && query.block_state('to:state') == 'ejected'",
				"components": {
					"minecraft:material_instances": {
						"*": { "texture": "mictlan_spawner_side_ominouse", "render_method": "alpha_test" },
						"up": {
							"texture": "mictlan_spawner_top_ejected_ominouse",
							"render_method": "alpha_test"
						},
						"down": { "texture": "mictlan_spawner_bottom", "render_method": "alpha_test" }
					}
				}
			},
			{
				"condition": "!query.block_state('to:is_ominouse') && (query.block_state('to:state') == 'idle' || query.block_state('to:state') == 'active')",
				"components": {
					"minecraft:material_instances": {
						"*": { "texture": "mictlan_spawner_side_on", "render_method": "alpha_test" },
						"up": { "texture": "mictlan_spawner_top_on", "render_method": "alpha_test" },
						"down": { "texture": "mictlan_spawner_bottom", "render_method": "alpha_test" }
					}
				}
			},
			{
				"condition": "!query.block_state('to:is_ominouse') && query.block_state('to:state') == 'ejected'",
				"components": {
					"minecraft:material_instances": {
						"*": { "texture": "mictlan_spawner_side_on", "render_method": "alpha_test" },
						"up": { "texture": "mictlan_spawner_top_ejected", "render_method": "alpha_test" },
						"down": { "texture": "mictlan_spawner_bottom", "render_method": "alpha_test" }
					}
				}
			}
		]
	}
}
