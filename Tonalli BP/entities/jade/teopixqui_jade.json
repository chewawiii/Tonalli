		"component_groups": {
			"to:cooldown": {
				"minecraft:timer": {
					"time": 2,
					"looping": false,
					"time_down_event": {
						"event": "to:target_sensor"
					}
				},
				"minecraft:on_hurt": {
					"event": "to:target_sensor"
				}
			},
			"to:target_sensor": {
				"minecraft:is_sheared": {},
