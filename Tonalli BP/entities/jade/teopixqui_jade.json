					"priority": 0
				},
				"minecraft:target_nearby_sensor": {
					"must_see": true,
					"inside_range": 5,
					"on_inside_range": {
						"event": "to:do_ranged_attack"
					},
					"outside_range": 6,
					"on_outside_range": {
						"event": "to:do_ranged_attack"
					}
				}
			},
			"to:ranged_attack": {
				"minecraft:mark_variant": {
					"value": 1
				},
				"minecraft:timer": {
					"time": 6.9,
					"looping": false,
					"time_down_event": {
						"event": "to:do_summon_allies"
					}
				}
			},
			"to:summon_allies": {
				"minecraft:mark_variant": {
					"value": 0
				},
				"minecraft:timer": {
					"time": 3,
					"looping": false,
					"time_down_event": {
						"event": "to:cooldown"
					}
				},
				"minecraft:behavior.summon_entity": {
					"priority": 0,
					"summon_choices": [
						{
							"weight": 1,
							"cast_duration": 3,
							"cooldown_time": 1,
							"sequence": [
