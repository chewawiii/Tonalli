{
	"format_version": "1.26.40",
	"minecraft:entity": {
		"description": {
			"identifier": "tonalli:teopixqui_jade",
			"is_experimental": false,
			"is_spawnable": true,
			"is_summonable": true,
			"scripts": {
				"animate": ["heal_allies_controller", "ranged_attack_controller"]
			},
			"animations": {
				"heal_allies_controller": "controller.animation.teopixqui_jade.heal",
				"heal_allies": "animation.teopixqui_jade.heal",
				"ranged_attack_controller": "controller.animation.teopixqui.ranged",
