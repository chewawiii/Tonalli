				"within_radius": 25,
				"reselect_targets": true,
				"must_see": true,
				"scan_interval": 20,
				"entity_types": [
					{
						"filters": {
							"any_of": [
								{
									"test": "is_family",
									"subject": "other",
									"value": "player"
								},
								{
									"test": "is_family",
									"subject": "other",
									"value": "iron_golem"
								},
								{
									"test": "is_family",
									"subject": "other",
									"value": "solar"
								}
							]
						}
					}
				]
			},
			"minecraft:behavior.random_stroll": {
				"priority": 4
			},
			"minecraft:behavior.look_at_target": {
				"priority": 5,
				"look_distance": 10,
				"probability": 0.8
			},
			"minecraft:behavior.random_look_around": {
				"priority": 8
			},

			"minecraft:hurt_on_condition": {
				"damage_conditions": [
					{
						"cause": "lava",
						"damage_per_tick": 4,
						"filters": { "test": "in_lava" }
					}
				]
			},
			"minecraft:loot": {
				"table": "loot_tables/entities/teopixqui_jade.json"
