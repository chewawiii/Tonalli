									"shape": "circle",
									"target": "target",
									"base_delay": 1.4,
									"entity_type": "tonalli:tezcatlipoca_follower",
									"num_entities_spawned": 3,
									"size": 2,
									"summon_event": "to:summon_particle"
								},
								{
									"shape": "circle",
									"target": "self",
									"base_delay": 0.5,
									"entity_type": "tonalli:jade_mask",
									"num_entities_spawned": 1,
									"size": 1,
									"summon_event": "to:summon_particle"
								}
							]
						}
					]
				}
			}
		},
		"events": {
			"minecraft:entity_spawned": {
				"add": {
					"component_groups": ["to:target_sensor"]
				}
			},
			"to:target_sensor": {
				"remove": {
					"component_groups": ["to:cooldown"]
				},
				"add": {
					"component_groups": ["to:target_sensor"]
				}
			},
			"to:cooldown": {
				"remove": {
					"component_groups": ["to:summon_allies", "to:ranged_attack", "to:target_sensor"]
				},
				"add": {
					"component_groups": ["to:cooldown"]
				}
			},
			"to:do_ranged_attack": {
				"sequence": [
					{
						"remove": {
							"component_groups": ["to:target_sensor"]
						}
					},
					{
						"add": {
							"component_groups": ["to:ranged_attack"]
						}
					}
				]
			},
			"to:do_summon_allies": {
				"sequence": [
					{
						"remove": {
							"component_groups": ["to:ranged_attack"]
						}
					},
					{
						"add": {
							"component_groups": ["to:summon_allies"]
						}
					}
				]
			}
		}
	}
}
