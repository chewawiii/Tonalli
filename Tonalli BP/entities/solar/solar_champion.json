{
	"format_version": "1.26.30",
	"minecraft:entity": {
		"description": {
			"identifier": "tonalli:solar_champion",
			"spawn_category": "monster",
			"is_experimental": false,
			"is_spawnable": true,
			"is_summonable": true,
			"properties": {
				"to:hit_count": {
					"type": "int",
					"range": [0, 2],
					"default": 0
				}
			}
		},
		"components": {
			"minecraft:type_family": {
				"family": ["tonalli", "monster", "solar_champion", "solar"]
			},
			"minecraft:health": {
				"value": 80,
				"max": 80
			},
			"minecraft:attack": {
				"damage": 25
			},
			"minecraft:collision_box": {
				"height": 1.9,
				"width": 0.6
			},
			"minecraft:movement": {
				"value": 0.2
			},

			"minecraft:physics": {},
			"minecraft:pushable_by_entity": {},
			"minecraft:pushable_by_block": {},

			"minecraft:movement.basic": {},
			"minecraft:jump.static": {},
			"minecraft:navigation.walk": {},

			"minecraft:behavior.hurt_by_target": {
				"priority": 1
			},
			"minecraft:behavior.nearest_attackable_target": {
				"priority": 2,
				"within_radius": 25,
				"reselect_targets": true,
				"entity_types": [
					{
						"filters": {
							"any_of": [
								{
									"test": "is_family",
									"subject": "other",
									"value": "player"
								},
								{
									"test": "is_family",
									"subject": "other",
									"value": "iron_golem"
								},
								{
									"test": "is_family",
									"subject": "other",
									"value": "jade"
								}
							]
						}
					}
				]
			},
			"minecraft:behavior.random_stroll": {
				"priority": 3
			},
			"minecraft:behavior.random_look_around": {
				"priority": 7
			},

			"minecraft:hurt_on_condition": {
				"damage_conditions": [
					{
						"cause": "lava",
						"damage_per_tick": 4,
						"filters": { "test": "in_lava" }
					}
				]
			},
			"minecraft:loot": {
				"table": "loot_tables/entities/solar_champion.json"
			},
			"minecraft:experience_reward": {
				"on_death": "query.last_hit_by_player ? Math.floor(Math.random(0,11)) + 10 : 0"
			},
			"minecraft:despawn": {
				"despawn_from_distance": {}
			}
		},
		"component_groups": {
			"to:increase_hit_count": {
				"minecraft:on_hurt_by_player": {
					"event": "to:increase_hit_count"
				}
			},
			"to:attack_1": {
				"minecraft:timer": {
					"time": 1.8,
					"looping": false,
					"time_down_event": {
						"event": "to:skill_switcher"
					}
				},
				"minecraft:behavior.delayed_attack": {
					"priority": 0,
					"attack_duration": 1.8,
					"hit_delay_pct": 0.45,
					"reach_multiplier": 4
				},
				"minecraft:mark_variant": {
					"value": 0
				}
			},
			"to:attack_2": {
				"minecraft:timer": {
					"time": 1.76,
					"looping": false,
					"time_down_event": {
						"event": "to:skill_switcher"
					}
				},
				"minecraft:behavior.delayed_attack": {
					"priority": 0,
					"attack_duration": 1.76,
					"hit_delay_pct": 0.3,
					"reach_multiplier": 4
				},
				"minecraft:mark_variant": {
					"value": 1
				}
			},
			"to:attack_3": {
				"minecraft:timer": {
					"time": 1.6,
					"looping": false,
					"time_down_event": {
						"event": "to:skill_switcher"
					}
				},
				"minecraft:behavior.delayed_attack": {
					"priority": 0,
					"attack_duration": 1.6,
					"hit_delay_pct": 0.3,
					"reach_multiplier": 4
				},
				"minecraft:mark_variant": {
					"value": 2
				}
			},
			"to:shield": {
				"minecraft:timer": {
					"time": 7,
					"looping": false,
					"time_down_event": {
						"event": "to:remove_shield"
					}
				},
				"minecraft:mark_variant": {
					"value": 3
				},
				"minecraft:damage_sensor": {
					"triggers": [
						{
							"cause": "all",
							"damage_multiplier": 0
						}
					]
				},
				"minecraft:knockback_resistance": {
					"value": 1
				}
			}
		},
		"events": {
			"minecraft:entity_spawned": {
				"add": {
					"component_groups": ["to:increase_hit_count"]
				},
				"trigger": {
					"event": "to:select_attack"
				}
			},
			"to:increase_hit_count": {
				"set_property": {
					"to:hit_count": "q.property('to:hit_count') + 1"
				}
			},
			"to:skill_switcher": {
				"first_valid": [
					{
						"filters": {
							"test": "int_property",
							"domain": "to:hit_count",
							"subject": "self",
							"value": 2
						},
						"remove": {
							"component_groups": [
								"to:increase_hit_count",
								"to:attack_1",
								"to:attack_2",
								"to:attack_3"
							]
						},
						"add": {
							"component_groups": ["to:shield"]
						}
					},
					{
						"trigger": {
							"event": "to:select_attack"
						}
					}
				]
			},
			"to:remove_shield": {
				"remove": {
					"component_groups": ["to:shield"]
				},
				"set_property": {
					"to:hit_count": 0
				},
				"trigger": {
					"event": "to:select_attack"
				},
				"add": {
					"component_groups": ["to:increase_hit_count"]
				}
			},
			"to:select_attack": {
				"sequence": [
					{
						"remove": {
							"component_groups": ["to:attack_1", "to:attack_2", "to:attack_3"]
						}
					},
					{
						"randomize": [
							{
								"weight": 1,
								"add": {
									"component_groups": ["to:attack_1"]
								}
							},
							{
								"weight": 1,
								"add": {
									"component_groups": ["to:attack_2"]
								}
							},
							{
								"weight": 1,
								"add": {
									"component_groups": ["to:attack_3"]
								}
							}
						]
					}
				]
			}
		}
	}
}
