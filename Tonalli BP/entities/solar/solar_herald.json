						"cause": "lava",
						"damage_per_tick": 4,
						"filters": {
							"test": "in_lava"
						}
					}
				]
			},
			"minecraft:loot": {
				"table": "loot_tables/entities/solar_herald.json"
			},
			"minecraft:experience_reward": {
