					"reach_multiplier": 4
				}
			},
			"to:attack_3_hit_2": {
				"minecraft:timer": {
					"time": 2,
					"looping": false,
					"time_down_event": {
						"event": "to:select_attack"
					}
				},
				"minecraft:behavior.delayed_attack": {
					"priority": 0,
					"attack_duration": 2,
					"hit_delay_pct": 0.5,
					"reach_multiplier": 4
				}
			}
		},
		"events": {
			"minecraft:entity_spawned": {
				"trigger": {
					"event": "to:select_attack"
				}
			},
			"to:select_attack": {
				"sequence": [
					{
						"remove": {
							"component_groups": ["to:attack_1", "to:attack_2", "to:attack_3"]
						}
					},
					{
						"randomize": [
							{
								"weight": 1,
								"add": {
									"component_groups": ["to:attack_1"]
								}
							},
							{
								"weight": 1,
								"add": {
									"component_groups": ["to:attack_2"]
								}
							},
							{
								"weight": 1,
								"add": {
									"component_groups": ["to:attack_3", "to:attack_3_hit_1"]
								}
							}
						]
					}
				]
			},
			"to:attack_3_hit_2": {
				"remove": {
					"component_groups": ["to:attack_3_hit_1"]
				},
				"add": {
					"component_groups": ["to:attack_3_hit_2"]
				}
