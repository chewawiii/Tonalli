			},
			"to:attack_2": {
				"minecraft:timer": {
					"time": 1.4,
					"looping": false,
					"time_down_event": {
						"event": "to:select_attack"
					}
				},
				"minecraft:behavior.delayed_attack": {
					"priority": 0,
					"attack_duration": 1.4,
					"hit_delay_pct": 0.5,
					"reach_multiplier": 4
				},
				"minecraft:mark_variant": {
					"value": 1
