			},
			"to:bite_attack": {
				"minecraft:variant": {
					"value": 0
				},
				"minecraft:behavior.delayed_attack": {
					"priority": 0,
					"attack_duration": 1,
					"hit_delay_pct": 0.7,
					"reach_multiplier": 4,
					"require_complete_path": true,
					"speed_multiplier": 1.4
				},
				"minecraft:timer": {
					"time": 3,
					"looping": true,
					"time_down_event": {
						"event": "to:random_skill"
					}
				}
			},
			"to:tail_attack": {
				"minecraft:variant": {
					"value": 1
				},
				"minecraft:behavior.delayed_attack": {
					"priority": 0,
					"attack_duration": 1.2,
					"hit_delay_pct": 0.5,
					"reach_multiplier": 4,
					"require_complete_path": false,
					"speed_multiplier": 1.4
				},
				"minecraft:timer": {
					"time": 3.6,
					"looping": true,
					"time_down_event": {
						"event": "to:random_skill"
					}
				}
			},
			"to:roar_event": {
				"minecraft:movement": {
					"value": 0
				},
				"minecraft:variant": {
					"value": 3
				},
				"minecraft:timer": {
					"time": 1.8,
					"looping": true,
					"time_down_event": {
						"event": "to:remove_roar_event",
						"target": "self"
					}
				}
			},
			"to:death_event": {
				"minecraft:transformation": {
					"into": "to:ahuizotl_death"
				}
			}
		},
		"events": {
			"minecraft:entity_spawned": {
				"add": {
					"component_groups": ["to:spawn_event"]
				}
			},
			"to:remove_spawn_event": {
				"remove": {
					"component_groups": ["to:spawn_event"]
				},
				"add": {
					"component_groups": ["to:movement"]
				}
			},
			"to:roar_event": {
				"add": {
					"component_groups": ["to:roar_event"]
				},
				"queue_command": {
					"command": "effect @e[type=player,r=10] weakness 60 0 true"
				}
			},
			"to:remove_roar_event": {
				"remove": {
					"component_groups": ["to:roar_event"]
				},
				"add": {
					"component_groups": ["to:movement", "to:bite_attack"]
				}
			},
			"to:remove_skill": {
				"remove": {
					"component_groups": ["to:bite_attack", "to:tail_attack"]
				}
			},
			"to:random_skill": {
				"sequence": [
					{
						"remove": {
							"component_groups": ["to:bite_attack", "to:tail_attack"]
						}
					},
					{
						"randomize": [
							{
								"weight": 5,
								"add": {
									"component_groups": ["to:bite_attack"]
								}
							},
							{
								"weight": 5,
								"add": {
									"component_groups": ["to:tail_attack"]
								}
							}
						]
					}
				]
			},
			"to:death_event": {
				"add": {
					"component_groups": ["to:death_event"]
				}
			}
		}
	}
}
