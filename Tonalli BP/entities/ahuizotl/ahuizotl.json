					"on_done": {
						"event": "to:remove_spawn_event"
					}
				},
				"minecraft:movement": {
					"value": 0
				},
				"minecraft:damage_sensor": {
					"triggers": [
						{
							"cause": "entity_attack",
							"deals_damage": "no"
						},
						{
							"cause": "fire",
							"deals_damage": "no"
						},
						{
							"cause": "projectile",
							"deals_damage": "no"
						},
						{
							"cause": "lava",
							"deals_damage": "no"
						},
						{
							"cause": "magic",
							"deals_damage": "no"
						},
						{
							"cause": "block_explosion",
							"deals_damage": "no"
						}
					]
				}
			},
			"to:movement": {
				"minecraft:behavior.hurt_by_target": {
					"priority": 1,
