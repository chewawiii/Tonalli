			},
			"minecraft:environment_sensor": {
				"triggers": [
					{
						"target": "self",
						"filters": {
							"test": "actor_health",
							"operator": "<=",
							"value": 1
						},
						"event": "to:death_event"
					}
				]
			}
		},
		"component_groups": {
			"to:spawn_event": {
				"minecraft:behavior.emerge": {
					"priority": 0,
